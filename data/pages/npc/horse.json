{"title":"Horse","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Horse is a named <a href=\"#/monster/horse-white\">White Horse</a> seen at level 10.</p>\n      \n      \n      <h2>Where to find Horse</h2>\n      \n      <ul class=\"wp-list\"><li>in the wilds around 1651, 1847</li></ul>\n      \n      <button type=\"button\" class=\"show-on-map\" data-map-kind=\"npc\" data-map-id=\"horse\">Show on map</button>\n      \n      <h2>Drops</h2><p class=\"muted\">No drops recorded for Horse yet.</p>\n      <h2>Other named White Horses</h2><p><a href=\"#/npc/white-mare\">White Mare</a></p>\n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic\"><img src=\"data/img/a40d3033779e14c5e652.webp\" alt=\"\"></div><h3>Horse</h3><table>\n      <tr><th>Kind</th><td><a href=\"#/monster/horse-white\">White Horse</a></td></tr>\n      <tr><th>Level</th><td>10</td></tr>\n      <tr><th>Hitpoints</th><td>31</td></tr><tr><th>Seen</th><td>32 times</td></tr>\n    </table></aside></article>"}