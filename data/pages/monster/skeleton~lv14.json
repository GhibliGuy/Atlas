on</h3><table>\n      <tr><th>Level</th><td><b>14</b> <span class=\"muted\">(picked · base 7)</span></td></tr>\n      <tr><th>Family</th><td>Skeleton</td></tr><tr><th>Attacks</th><td>stab · ranged</td></tr>\n      <tr><th>Hitpoints</th><td>43</td></tr><tr><th>Damage</th><td>12.2</td></tr><tr><th>XP</th><td>700</td></tr>\n      <tr><th>Attack speed</th><td>3.8 s</td></tr><tr><th>Attack range</th><td>5</td></tr>\n      <tr><th>Aggressive</th><td>Yes (7 tiles)</td></tr>\n      <tr><th>Drops gems</th><td>Yes</td></tr>\n      <tr><th>Seen</th><td>51 times</td></tr>\n    </table></aside></article>"}