erhead</h3><table>\n      <tr><th>Level</th><td>25 <span class=\"muted\">(seen 0–24)</span></td></tr>\n      <tr><th>Family</th><td>Snake</td></tr><tr><th>Attacks</th><td>corrode · melee</td></tr>\n      <tr><th>Hitpoints</th><td>89</td></tr><tr><th>Damage</th><td>18</td></tr><tr><th>XP</th><td>1250</td></tr>\n      <tr><th>Attack speed</th><td>3.8 s</td></tr><tr><th>Attack range</th><td>1.6</td></tr>\n      <tr><th>Aggressive</th><td>Yes (7 tiles)</td></tr>\n      <tr><th>Drops gems</th><td>No</td></tr><tr><th>Pendant / cape</th><td>Can drop</td></tr>\n      <tr><th>Seen</th><td>6 times</td></tr>\n    </table></aside></article>"}