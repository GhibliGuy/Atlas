{"title":"Chicken Pot Pie","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Cooking Lv 5)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Cooking at level 5 <span class=\"muted\">(25 XP)</span> from 1× <a href=\"#/item/dough\">Dough</a>, 1× <a href=\"#/item/raw-chicken\">Raw Chicken</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/cooking\">Cooking</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/dough\"><img class=\"q-mini\" src=\"data/img/gen/e970131a5beadf11d4b4.svg\" alt=\"\">Dough</a><a class=\"rel-chip\" href=\"#/item/raw-chicken\"><img class=\"q-mini\" src=\"data/img/gen/e29d69649ec17f1a2e22.svg\" alt=\"\">Raw Chicken</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/b5cba4e12897788aaa81.svg\" alt=\"Chicken Pot Pie\"></div><h3>Chicken Pot Pie</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Cooking 5</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}