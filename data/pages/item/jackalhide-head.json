{"title":"Jackalhide Head","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Leatherworking Lv 20)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Leatherworking at level 20 <span class=\"muted\">(458 XP)</span> from 1× <a href=\"#/item/jackal-pelt\">Jackal Pelt</a>, 2× <a href=\"#/item/wool\">Wool</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/leatherworking\">Leatherworking</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/jackal-pelt\"><img class=\"q-mini\" src=\"data/img/gen/e1bfc3fbda7c5470b088.svg\" alt=\"\">Jackal Pelt</a><a class=\"rel-chip\" href=\"#/item/wool\"><img class=\"q-mini\" src=\"data/img/gen/5591944d6121d6a586be.svg\" alt=\"\">Wool</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/cd220ec8b4588ac36d9c.svg\" alt=\"Jackalhide Head\"></div><h3>Jackalhide Head</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Leatherworking 20</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}