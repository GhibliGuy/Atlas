{"title":"Poisoned Bolt","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Herblore Lv 50)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Herblore at level 50 <span class=\"muted\">(60 XP)</span> from 1× <a href=\"#/item/weapon-poison\">Weapon Poison</a>, 60× <a href=\"#/item/bolt\">Bolt</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/herblore\">Herblore</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/weapon-poison\"><img class=\"q-mini\" src=\"data/img/4c20e368575a4f4eca72.svg\" alt=\"\">Weapon Poison</a><a class=\"rel-chip\" href=\"#/item/bolt\"><img class=\"q-mini\" src=\"data/img/b4362887a1f8d7b3462f.svg\" alt=\"\">Bolt</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/f895175f65abc66f4d51.svg\" alt=\"Poisoned Bolt\"></div><h3>Poisoned Bolt</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Herblore 50</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}