{"title":"Weak Weapon Poison","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Herblore Lv 30)</p>\n      \n      \n      <h2>How to get it</h2>\n      \n      <p><b>Crafted</b> with Herblore at level 30 <span class=\"muted\">(120 XP)</span> from 2× <a href=\"#/item/mandrake-root\">Mandrake Root</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/herblore\">Herblore</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/mandrake-root\"><img class=\"q-mini\" src=\"data/img/dcf5971c77d5b8e4ca6d.svg\" alt=\"\">Mandrake Root</a></p>\n      <h2>Used to make</h2><ul class=\"wp-list\"><li><a href=\"#/item/weak-poisoned-arrow\">Weak Poisoned Arrow</a> <span class=\"muted\">· Herblore 30</span></li><li><a href=\"#/item/weak-poisoned-bolt\">Weak Poisoned Bolt</a> <span class=\"muted\">· Herblore 30</span></li></ul>\n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/0dd7828ed0b05ec4a067.svg\" alt=\"Weak Weapon Poison\"></div><h3>Weak Weapon Poison</h3><table>\n      \n      \n      <tr><th>Made with</th><td>Herblore 30</td></tr>\n      \n      \n      <tr><th>Used in</th><td>2 recipes</td></tr>\n      \n    </table></aside></article>"}