{"title":"Scroll Mana","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Scribing Lv 5)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Scribing at level 5 <span class=\"muted\">(80 XP)</span> from 2× <a href=\"#/item/parchment\">Parchment</a>, 4× <a href=\"#/item/woad-pigment\">Woad Pigment</a>, 1× <a href=\"#/item/mire-essence\">Mire Essence</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/scribing\">Scribing</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/parchment\"><img class=\"q-mini\" src=\"data/img/gen/75c401c173753c072f3e.svg\" alt=\"\">Parchment</a><a class=\"rel-chip\" href=\"#/item/woad-pigment\"><img class=\"q-mini\" src=\"data/img/gen/b54e1d2a3136092bd4bd.svg\" alt=\"\">Woad Pigment</a><a class=\"rel-chip\" href=\"#/item/mire-essence\"><img class=\"q-mini\" src=\"data/img/gen/7018b8156a59cd2cbee3.svg\" alt=\"\">Mire Essence</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/b079ad6a7d3b76f4937e.svg\" alt=\"Scroll Mana\"></div><h3>Scroll Mana</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Scribing 5</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}