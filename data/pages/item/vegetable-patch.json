{"title":"Vegetable Patch","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Carpentry Lv 9)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Carpentry at level 9 <span class=\"muted\">(94 XP)</span> from 4× <a href=\"#/item/pine-plank\">Pine Plank</a>, 2× <a href=\"#/item/iron-fittings\">Iron Fittings</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/carpentry\">Carpentry</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/pine-plank\"><img class=\"q-mini\" src=\"data/img/gen/b39ef5c3e48e514d66cd.svg\" alt=\"\">Pine Plank</a><a class=\"rel-chip\" href=\"#/item/iron-fittings\"><img class=\"q-mini\" src=\"data/img/gen/f8c979df6344ede0f746.svg\" alt=\"\">Iron Fittings</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/cad1bf51739b0fce9b8d.svg\" alt=\"Vegetable Patch\"></div><h3>Vegetable Patch</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Carpentry 9</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}