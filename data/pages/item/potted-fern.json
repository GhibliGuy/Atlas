{"title":"Potted Fern","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Carpentry Lv 5)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Carpentry at level 5 <span class=\"muted\">(62 XP)</span> from 2× <a href=\"#/item/pine-plank\">Pine Plank</a>, 1× <a href=\"#/item/iron-fittings\">Iron Fittings</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/carpentry\">Carpentry</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/pine-plank\"><img class=\"q-mini\" src=\"data/img/0b9d6f85149895f49ef8.svg\" alt=\"\">Pine Plank</a><a class=\"rel-chip\" href=\"#/item/iron-fittings\"><img class=\"q-mini\" src=\"data/img/8e5973b7cf38778c613e.svg\" alt=\"\">Iron Fittings</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/923a8fa7db461abc4af7.svg\" alt=\"Potted Fern\"></div><h3>Potted Fern</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Carpentry 5</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}