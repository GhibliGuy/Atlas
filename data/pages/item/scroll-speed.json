{"title":"Scroll Speed","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Scribing Lv 5)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Scribing at level 5 <span class=\"muted\">(120 XP)</span> from 2× <a href=\"#/item/parchment\">Parchment</a>, 6× <a href=\"#/item/madder-pigment\">Madder Pigment</a>, 1× <a href=\"#/item/gossamer-wing\">Gossamer Wing</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/scribing\">Scribing</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/parchment\"><img class=\"q-mini\" src=\"data/img/70f48aa35bee0e56fc9a.svg\" alt=\"\">Parchment</a><a class=\"rel-chip\" href=\"#/item/madder-pigment\"><img class=\"q-mini\" src=\"data/img/ca0f50d72ea5eda33c57.svg\" alt=\"\">Madder Pigment</a><a class=\"rel-chip\" href=\"#/item/gossamer-wing\"><img class=\"q-mini\" src=\"data/img/20293d1b1defcc2a16d0.svg\" alt=\"\">Gossamer Wing</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/1a480e999dc22762852b.svg\" alt=\"Scroll Speed\"></div><h3>Scroll Speed</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Scribing 5</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}