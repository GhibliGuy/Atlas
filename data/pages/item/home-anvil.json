{"title":"Home Anvil","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Carpentry Lv 20)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Carpentry at level 20 <span class=\"muted\">(182 XP)</span> from 6× <a href=\"#/item/pine-plank\">Pine Plank</a>, 6× <a href=\"#/item/iron-fittings\">Iron Fittings</a>.</p>\n      \n      \n      <div class=\"s muted\">No monster drops recorded for this item.</div>\n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/carpentry\">Carpentry</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/pine-plank\"><img class=\"q-mini\" src=\"data/img/0b9d6f85149895f49ef8.svg\" alt=\"\">Pine Plank</a><a class=\"rel-chip\" href=\"#/item/iron-fittings\"><img class=\"q-mini\" src=\"data/img/8e5973b7cf38778c613e.svg\" alt=\"\">Iron Fittings</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/ff0c74d6b2cf1f6ee4af.svg\" alt=\"Home Anvil\"></div><h3>Home Anvil</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Carpentry 20</td></tr>\n      <tr><th>Dropped by</th><td>—</td></tr>\n      \n      \n      <tr><th>Last seen</th><td>10/4/2026, 1:49:29 AM</td></tr>\n    </table></aside></article>"}