{"title":"Bearhide Spellbook","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Leatherworking Lv 20)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Leatherworking at level 20 <span class=\"muted\">(750 XP)</span> from 6× <a href=\"#/item/parchment\">Parchment</a>, 2× <a href=\"#/item/bear-hide\">Bear Hide</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/leatherworking\">Leatherworking</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/parchment\"><img class=\"q-mini\" src=\"data/img/70f48aa35bee0e56fc9a.svg\" alt=\"\">Parchment</a><a class=\"rel-chip\" href=\"#/item/bear-hide\"><img class=\"q-mini\" src=\"data/img/b5fe7fee0b1329cf8742.svg\" alt=\"\">Bear Hide</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/27b24e826a9855fa5877.svg\" alt=\"Bearhide Spellbook\"></div><h3>Bearhide Spellbook</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Leatherworking 20</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}