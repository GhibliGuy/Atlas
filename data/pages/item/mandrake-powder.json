{"title":"Mandrake Powder","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Herblore Lv 30)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      <p><b>Crafted</b> with Herblore at level 30 <span class=\"muted\">(120 XP)</span> from 2× <a href=\"#/item/mandrake-root\">Mandrake Root</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/herblore\">Herblore</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/mandrake-root\"><img class=\"q-mini\" src=\"data/img/dcf5971c77d5b8e4ca6d.svg\" alt=\"\">Mandrake Root</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/0e3a9dab6db1acf80795.svg\" alt=\"Mandrake Powder\"></div><h3>Mandrake Powder</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Herblore 30</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}