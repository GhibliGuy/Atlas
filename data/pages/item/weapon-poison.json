{"title":"Weapon Poison","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Herblore Lv 50)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      <p><b>Crafted</b> with Herblore at level 50 <span class=\"muted\">(300 XP)</span> from 2× <a href=\"#/item/wolfsbane\">Wolfsbane</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/herblore\">Herblore</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/wolfsbane\"><img class=\"q-mini\" src=\"data/img/45236d1e393e6cb66fba.svg\" alt=\"\">Wolfsbane</a></p>\n      <h2>Used to make</h2><ul class=\"wp-list\"><li><a href=\"#/item/poisoned-arrow\">Poisoned Arrow</a> <span class=\"muted\">· Herblore 50</span></li><li><a href=\"#/item/poisoned-bolt\">Poisoned Bolt</a> <span class=\"muted\">· Herblore 50</span></li></ul>\n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/4c20e368575a4f4eca72.svg\" alt=\"Weapon Poison\"></div><h3>Weapon Poison</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Herblore 50</td></tr>\n      \n      \n      <tr><th>Used in</th><td>2 recipes</td></tr>\n      \n    </table></aside></article>"}