{"title":"Poisoned Arrow","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Herblore Lv 50)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Herblore at level 50 <span class=\"muted\">(60 XP)</span> from 1× <a href=\"#/item/weapon-poison\">Weapon Poison</a>, 60× <a href=\"#/item/arrow\">Arrow</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/herblore\">Herblore</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/weapon-poison\"><img class=\"q-mini\" src=\"data/img/gen/6757eb5dded7097a6f36.svg\" alt=\"\">Weapon Poison</a><a class=\"rel-chip\" href=\"#/item/arrow\"><img class=\"q-mini\" src=\"data/img/gen/9191c8dd4b9d680ba32e.svg\" alt=\"\">Arrow</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/86d67dca2914df5b9435.svg\" alt=\"Poisoned Arrow\"></div><h3>Poisoned Arrow</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Herblore 50</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}