{"title":"Dragonhide Spellbook","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Leatherworking Lv 50)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Leatherworking at level 50 <span class=\"muted\">(4688 XP)</span> from 10× <a href=\"#/item/parchment\">Parchment</a>, 2× <a href=\"#/item/dragon-hide\">Dragon Hide</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/leatherworking\">Leatherworking</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/parchment\"><img class=\"q-mini\" src=\"data/img/70f48aa35bee0e56fc9a.svg\" alt=\"\">Parchment</a><a class=\"rel-chip\" href=\"#/item/dragon-hide\"><img class=\"q-mini\" src=\"data/img/9e2b88dfaf721a2d79c9.svg\" alt=\"\">Dragon Hide</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/b2e1d7e688ea4744a792.svg\" alt=\"Dragonhide Spellbook\"></div><h3>Dragonhide Spellbook</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Leatherworking 50</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}