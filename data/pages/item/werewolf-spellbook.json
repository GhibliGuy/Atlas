{"title":"Werewolf Spellbook","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Leatherworking Lv 35)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Leatherworking at level 35 <span class=\"muted\">(1875 XP)</span> from 8× <a href=\"#/item/parchment\">Parchment</a>, 2× <a href=\"#/item/werewolf-pelt\">Werewolf Pelt</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/leatherworking\">Leatherworking</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/parchment\"><img class=\"q-mini\" src=\"data/img/70f48aa35bee0e56fc9a.svg\" alt=\"\">Parchment</a><a class=\"rel-chip\" href=\"#/item/werewolf-pelt\"><img class=\"q-mini\" src=\"data/img/ef6770c8d1b158c56195.svg\" alt=\"\">Werewolf Pelt</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/75cfe4ca1aa3d6fdc8ca.svg\" alt=\"Werewolf Spellbook\"></div><h3>Werewolf Spellbook</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Leatherworking 35</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}