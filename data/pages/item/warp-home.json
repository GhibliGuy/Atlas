{"title":"Warp Home","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Scribing Lv 30)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Scribing at level 30 <span class=\"muted\">(2120 XP)</span> from 2× <a href=\"#/item/parchment\">Parchment</a>, 6× <a href=\"#/item/madder-pigment\">Madder Pigment</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/scribing\">Scribing</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/parchment\"><img class=\"q-mini\" src=\"data/img/70f48aa35bee0e56fc9a.svg\" alt=\"\">Parchment</a><a class=\"rel-chip\" href=\"#/item/madder-pigment\"><img class=\"q-mini\" src=\"data/img/ca0f50d72ea5eda33c57.svg\" alt=\"\">Madder Pigment</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/945375b65135a2bc5938.svg\" alt=\"Warp Home\"></div><h3>Warp Home</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Scribing 30</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}