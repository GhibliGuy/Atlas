{"title":"Carapace Arms","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Armor Smithing Lv 18)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Armor Smithing at level 18 <span class=\"muted\">(375 XP)</span> from 3× <a href=\"#/item/silver-bar\">Silver Bar</a>, 1× <a href=\"#/item/scorpion-carapace\">Scorpion Carapace</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/armor-smithing\">Armor smithing</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/silver-bar\"><img class=\"q-mini\" src=\"data/img/gen/d12a7bb1c5350d4880d6.svg\" alt=\"\">Silver Bar</a><a class=\"rel-chip\" href=\"#/item/scorpion-carapace\"><img class=\"q-mini\" src=\"data/img/gen/d84c8ef811c34c2490ac.svg\" alt=\"\">Scorpion Carapace</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/387f109067c60649237a.svg\" alt=\"Carapace Arms\"></div><h3>Carapace Arms</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Armor Smithing 18</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}