{"title":"Weak Poisoned Arrow","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Herblore Lv 30)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Herblore at level 30 <span class=\"muted\">(30 XP)</span> from 1× <a href=\"#/item/weak-weapon-poison\">Weak Weapon Poison</a>, 60× <a href=\"#/item/arrow\">Arrow</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/herblore\">Herblore</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/weak-weapon-poison\"><img class=\"q-mini\" src=\"data/img/0dd7828ed0b05ec4a067.svg\" alt=\"\">Weak Weapon Poison</a><a class=\"rel-chip\" href=\"#/item/arrow\"><img class=\"q-mini\" src=\"data/img/f8e0f872cc502e1dabe7.svg\" alt=\"\">Arrow</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/2977a9a8dc2a2865a0cf.svg\" alt=\"Weak Poisoned Arrow\"></div><h3>Weak Poisoned Arrow</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Herblore 30</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}