{"title":"Yetihide Arms","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Leatherworking Lv 63)</p>\n      \n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Leatherworking at level 63 <span class=\"muted\">(9756 XP)</span> from 2× <a href=\"#/item/yeti-hide\">Yeti Hide</a>, 5× <a href=\"#/item/frostwool\">Frostwool</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/leatherworking\">Leatherworking</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/yeti-hide\"><img class=\"q-mini\" src=\"data/img/gen/978483ebfccb2cae6e0d.svg\" alt=\"\">Yeti Hide</a><a class=\"rel-chip\" href=\"#/item/frostwool\"><img class=\"q-mini\" src=\"data/img/gen/e624028c088a03d47c1f.svg\" alt=\"\">Frostwool</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/74aabbfabee855538164.svg\" alt=\"Yetihide Arms\"></div><h3>Yetihide Arms</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Leatherworking 63</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}