{"title":"Thorn Feet","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Armor Smithing Lv 46)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Armor Smithing at level 46 <span class=\"muted\">(2109 XP)</span> from 3× <a href=\"#/item/titanium-bar\">Titanium Bar</a>, 1× <a href=\"#/item/thorn-cutting\">Thorn Cutting</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/armor-smithing\">Armor smithing</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/titanium-bar\"><img class=\"q-mini\" src=\"data/img/1f1604dc88f4e382bd7e.svg\" alt=\"\">Titanium Bar</a><a class=\"rel-chip\" href=\"#/item/thorn-cutting\"><img class=\"q-mini\" src=\"data/img/32fe2a6f1fb8885c9afb.svg\" alt=\"\">Thorn Cutting</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/c545c7eb5d27184e604d.svg\" alt=\"Thorn Feet\"></div><h3>Thorn Feet</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Armor Smithing 46</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}