{"title":"Scroll Intellect","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Scribing Lv 5)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Scribing at level 5 <span class=\"muted\">(120 XP)</span> from 2× <a href=\"#/item/parchment\">Parchment</a>, 6× <a href=\"#/item/madder-pigment\">Madder Pigment</a>, 1× <a href=\"#/item/ancient-acorn\">Ancient Acorn</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/scribing\">Scribing</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/parchment\"><img class=\"q-mini\" src=\"data/img/gen/75c401c173753c072f3e.svg\" alt=\"\">Parchment</a><a class=\"rel-chip\" href=\"#/item/madder-pigment\"><img class=\"q-mini\" src=\"data/img/gen/cf8cdcd2ea1e2b28d633.svg\" alt=\"\">Madder Pigment</a><a class=\"rel-chip\" href=\"#/item/ancient-acorn\"><img class=\"q-mini\" src=\"data/img/gen/a5cca1ac3d0d3fe3a7b9.svg\" alt=\"\">Ancient Acorn</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/3c47328d2e77fc02c0a2.svg\" alt=\"Scroll Intellect\"></div><h3>Scroll Intellect</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Scribing 5</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}