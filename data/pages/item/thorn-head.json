{"title":"Thorn Head","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Armor Smithing Lv 50)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Armor Smithing at level 50 <span class=\"muted\">(3431 XP)</span> from 4× <a href=\"#/item/titanium-bar\">Titanium Bar</a>, 1× <a href=\"#/item/thorn-cutting\">Thorn Cutting</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/armor-smithing\">Armor smithing</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/titanium-bar\"><img class=\"q-mini\" src=\"data/img/gen/dd129647f99f5468086c.svg\" alt=\"\">Titanium Bar</a><a class=\"rel-chip\" href=\"#/item/thorn-cutting\"><img class=\"q-mini\" src=\"data/img/gen/12422eb77362d71b37fc.svg\" alt=\"\">Thorn Cutting</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/dd84a2400daf93f8aefd.svg\" alt=\"Thorn Head\"></div><h3>Thorn Head</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Armor Smithing 50</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}