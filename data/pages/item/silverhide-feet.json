{"title":"Silverhide Feet","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Leatherworking Lv 46)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Leatherworking at level 46 <span class=\"muted\">(2344 XP)</span> from 1× <a href=\"#/item/silver-hide\">Silver Hide</a>, 4× <a href=\"#/item/wool\">Wool</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/leatherworking\">Leatherworking</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/silver-hide\"><img class=\"q-mini\" src=\"data/img/gen/d0129dab5d31cee2360d.svg\" alt=\"\">Silver Hide</a><a class=\"rel-chip\" href=\"#/item/wool\"><img class=\"q-mini\" src=\"data/img/gen/5591944d6121d6a586be.svg\" alt=\"\">Wool</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/92c0036a438d222d1832.svg\" alt=\"Silverhide Feet\"></div><h3>Silverhide Feet</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Leatherworking 46</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}