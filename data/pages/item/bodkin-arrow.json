{"title":"Bodkin Arrow","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Bowyer Lv 25)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Bowyer at level 25 <span class=\"muted\">(47 XP)</span> from 10× <a href=\"#/item/arrow\">Arrow</a>, 1× <a href=\"#/item/iron-bar\">Iron Bar</a>, 1× <a href=\"#/item/flight-feather\">Flight Feather</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/bowyer\">Bowyer</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/arrow\"><img class=\"q-mini\" src=\"data/img/f8e0f872cc502e1dabe7.svg\" alt=\"\">Arrow</a><a class=\"rel-chip\" href=\"#/item/iron-bar\"><img class=\"q-mini\" src=\"data/img/b05bccaf779cfe4ebfbe.svg\" alt=\"\">Iron Bar</a><a class=\"rel-chip\" href=\"#/item/flight-feather\"><img class=\"q-mini\" src=\"data/img/e99c04a7b052d79e71e0.svg\" alt=\"\">Flight Feather</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/783df96b7bc485a821bd.svg\" alt=\"Bodkin Arrow\"></div><h3>Bodkin Arrow</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Bowyer 25</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}