{"title":"Arrow","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Bowyer Lv 1)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Bowyer at level 1 <span class=\"muted\">(47 XP)</span> from 1× <a href=\"#/item/pine-wood\">Pine Wood</a>, 2× <a href=\"#/item/feather\">Feather</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/bowyer\">Bowyer</a> · <a href=\"#/guide/herblore\">Herblore</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/pine-wood\"><img class=\"q-mini\" src=\"data/img/gen/c1da01d099b56c842ef6.svg\" alt=\"\">Pine Wood</a><a class=\"rel-chip\" href=\"#/item/feather\"><img class=\"q-mini\" src=\"data/img/gen/a9e8d64cbc4ac0459038.svg\" alt=\"\">Feather</a></p>\n      <h2>Used to make</h2><ul class=\"wp-list\"><li><a href=\"#/item/bodkin-arrow\">Bodkin Arrow</a> <span class=\"muted\">· Bowyer 25</span></li><li><a href=\"#/item/weak-poisoned-arrow\">Weak Poisoned Arrow</a> <span class=\"muted\">· Herblore 30</span></li><li><a href=\"#/item/poisoned-arrow\">Poisoned Arrow</a> <span class=\"muted\">· Herblore 50</span></li><li><a href=\"#/item/potent-poisoned-arrow\">Potent Poisoned Arrow</a> <span class=\"muted\">· Herblore 70</span></li></ul>\n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/9191c8dd4b9d680ba32e.svg\" alt=\"Arrow\"></div><h3>Arrow</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Bowyer 1</td></tr>\n      \n      \n      <tr><th>Used in</th><td>4 recipes</td></tr>\n      \n    </table></aside></article>"}