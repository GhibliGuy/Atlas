{"title":"Scroll Strength","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Scribing Lv 5)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Scribing at level 5 <span class=\"muted\">(120 XP)</span> from 2× <a href=\"#/item/parchment\">Parchment</a>, 6× <a href=\"#/item/madder-pigment\">Madder Pigment</a>, 1× <a href=\"#/item/boar-tusk\">Boar Tusk</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/scribing\">Scribing</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/parchment\"><img class=\"q-mini\" src=\"data/img/gen/75c401c173753c072f3e.svg\" alt=\"\">Parchment</a><a class=\"rel-chip\" href=\"#/item/madder-pigment\"><img class=\"q-mini\" src=\"data/img/gen/cf8cdcd2ea1e2b28d633.svg\" alt=\"\">Madder Pigment</a><a class=\"rel-chip\" href=\"#/item/boar-tusk\"><img class=\"q-mini\" src=\"data/img/gen/0dcece2c2ca40443003f.svg\" alt=\"\">Boar Tusk</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/5ca769b83b2fab3b08f0.svg\" alt=\"Scroll Strength\"></div><h3>Scroll Strength</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Scribing 5</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}