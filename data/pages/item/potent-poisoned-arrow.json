{"title":"Potent Poisoned Arrow","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Herblore Lv 70)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Herblore at level 70 <span class=\"muted\">(120 XP)</span> from 1× <a href=\"#/item/potent-weapon-poison\">Potent Weapon Poison</a>, 60× <a href=\"#/item/arrow\">Arrow</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/herblore\">Herblore</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/potent-weapon-poison\"><img class=\"q-mini\" src=\"data/img/gen/86f88471d980a08b000b.svg\" alt=\"\">Potent Weapon Poison</a><a class=\"rel-chip\" href=\"#/item/arrow\"><img class=\"q-mini\" src=\"data/img/gen/9191c8dd4b9d680ba32e.svg\" alt=\"\">Arrow</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/5057b1c9c7f76067c36b.svg\" alt=\"Potent Poisoned Arrow\"></div><h3>Potent Poisoned Arrow</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Herblore 70</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}