{"title":"Pine Chair","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Carpentry Lv 4)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Carpentry at level 4 <span class=\"muted\">(54 XP)</span> from 3× <a href=\"#/item/pine-plank\">Pine Plank</a>, 1× <a href=\"#/item/iron-fittings\">Iron Fittings</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/carpentry\">Carpentry</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/pine-plank\"><img class=\"q-mini\" src=\"data/img/0b9d6f85149895f49ef8.svg\" alt=\"\">Pine Plank</a><a class=\"rel-chip\" href=\"#/item/iron-fittings\"><img class=\"q-mini\" src=\"data/img/8e5973b7cf38778c613e.svg\" alt=\"\">Iron Fittings</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/04371d44a395ebdc3f6e.svg\" alt=\"Pine Chair\"></div><h3>Pine Chair</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Carpentry 4</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}