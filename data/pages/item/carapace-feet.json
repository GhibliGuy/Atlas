{"title":"Carapace Feet","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Armor Smithing Lv 16)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Armor Smithing at level 16 <span class=\"muted\">(338 XP)</span> from 3× <a href=\"#/item/silver-bar\">Silver Bar</a>, 1× <a href=\"#/item/scorpion-carapace\">Scorpion Carapace</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/armor-smithing\">Armor smithing</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/silver-bar\"><img class=\"q-mini\" src=\"data/img/f78897e9b222ef2ef0f2.svg\" alt=\"\">Silver Bar</a><a class=\"rel-chip\" href=\"#/item/scorpion-carapace\"><img class=\"q-mini\" src=\"data/img/29de9072db7d3b475f5a.svg\" alt=\"\">Scorpion Carapace</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/799dce525c4960d5c034.svg\" alt=\"Carapace Feet\"></div><h3>Carapace Feet</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Armor Smithing 16</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}