{"title":"Tungsten Hoe","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Tool Smithing Lv 62)</p>\n      \n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Tool Smithing at level 62 <span class=\"muted\">(5563 XP)</span> from 2× <a href=\"#/item/tungsten-bar\">Tungsten Bar</a>, 2× <a href=\"#/item/bloodwood-wood\">Bloodwood Wood</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/tool-smithing\">Tool smithing</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/tungsten-bar\"><img class=\"q-mini\" src=\"data/img/gen/90d5101aaf9e1e5575c8.svg\" alt=\"\">Tungsten Bar</a><a class=\"rel-chip\" href=\"#/item/bloodwood-wood\"><img class=\"q-mini\" src=\"data/img/gen/c9a448798b51fc7495b2.svg\" alt=\"\">Bloodwood Wood</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/b12b9dd2cc52d5bf1b7d.svg\" alt=\"Tungsten Hoe\"></div><h3>Tungsten Hoe</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Tool Smithing 62</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}