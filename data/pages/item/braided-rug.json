{"title":"Braided Rug","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Carpentry Lv 2)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      <p><b>Crafted</b> with Carpentry at level 2 <span class=\"muted\">(38 XP)</span> from 8× <a href=\"#/item/flax-fiber\">Flax Fiber</a>, 1× <a href=\"#/item/pine-plank\">Pine Plank</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/carpentry\">Carpentry</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/flax-fiber\"><img class=\"q-mini\" src=\"data/img/344357a5592ac28ec79f.svg\" alt=\"\">Flax Fiber</a><a class=\"rel-chip\" href=\"#/item/pine-plank\"><img class=\"q-mini\" src=\"data/img/0b9d6f85149895f49ef8.svg\" alt=\"\">Pine Plank</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/898d12b3537665f35cab.svg\" alt=\"Braided Rug\"></div><h3>Braided Rug</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Carpentry 2</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}