{"title":"Shellweave Torso","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Tailoring Lv 26)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Tailoring at level 26 <span class=\"muted\">(1163 XP)</span> from 2× <a href=\"#/item/iridescent-carapace\">Iridescent Carapace</a>, 4× <a href=\"#/item/wool\">Wool</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/tailoring\">Tailoring</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/iridescent-carapace\"><img class=\"q-mini\" src=\"data/img/be9151e50c9d8d997175.svg\" alt=\"\">Iridescent Carapace</a><a class=\"rel-chip\" href=\"#/item/wool\"><img class=\"q-mini\" src=\"data/img/e1728324d6942e9b4191.svg\" alt=\"\">Wool</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/e2a76411a786dcc6c953.svg\" alt=\"Shellweave Torso\"></div><h3>Shellweave Torso</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Tailoring 26</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}