{"title":"Warp Plymouth Wharf","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Scribing Lv 10)</p>\n      \n      \n      \n      \n      \n      <h2>How to get it</h2>\n      \n      \n      <p><b>Crafted</b> with Scribing at level 10 <span class=\"muted\">(1120 XP)</span> from 2× <a href=\"#/item/parchment\">Parchment</a>, 6× <a href=\"#/item/woad-pigment\">Woad Pigment</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/scribing\">Scribing</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/parchment\"><img class=\"q-mini\" src=\"data/img/gen/75c401c173753c072f3e.svg\" alt=\"\">Parchment</a><a class=\"rel-chip\" href=\"#/item/woad-pigment\"><img class=\"q-mini\" src=\"data/img/gen/b54e1d2a3136092bd4bd.svg\" alt=\"\">Woad Pigment</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/gen/32fee1bbb353bb713352.svg\" alt=\"Warp Plymouth Wharf\"></div><h3>Warp Plymouth Wharf</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Scribing 10</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}