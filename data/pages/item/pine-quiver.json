{"title":"Pine Quiver","html":"<article class=\"wp\"><div class=\"wp-main\">\n      <p class=\"wp-lede\">Crafted (Bowyer Lv 3)</p>\n      \n      \n      \n      <h2>How to get it</h2>\n      \n      <p><b>Crafted</b> with Bowyer at level 3 <span class=\"muted\">(261 XP)</span> from 5× <a href=\"#/item/pine-wood\">Pine Wood</a>, 2× <a href=\"#/item/wool\">Wool</a>.</p>\n      \n      \n      \n      \n      <p class=\"wp-guides\"><b>Guides:</b> <a href=\"#/guide/bowyer\">Bowyer</a></p>\n      \n      \n      <h2>Related</h2><p class=\"rel-row\"><b>Other materials</b> <a class=\"rel-chip\" href=\"#/item/oak-quiver\"><img class=\"q-mini\" src=\"data/img/df8e594a6bdfb41332fe.svg\" alt=\"\">Oak Quiver</a><a class=\"rel-chip\" href=\"#/item/black-walnut-quiver\"><img class=\"q-mini\" src=\"data/img/084efde70fcbb83e4f46.svg\" alt=\"\">Black Walnut Quiver</a><a class=\"rel-chip\" href=\"#/item/shagbark-quiver\"><img class=\"q-mini\" src=\"data/img/e063015a7d825d8640e3.svg\" alt=\"\">Shagbark Quiver</a></p><p class=\"rel-row\"><b>Made from</b> <a class=\"rel-chip\" href=\"#/item/pine-wood\"><img class=\"q-mini\" src=\"data/img/ed4497dc146bd38c40c7.svg\" alt=\"\">Pine Wood</a><a class=\"rel-chip\" href=\"#/item/wool\"><img class=\"q-mini\" src=\"data/img/e1728324d6942e9b4191.svg\" alt=\"\">Wool</a></p>\n      \n    </div><aside class=\"wp-infobox\"><div class=\"wp-pic \"><img src=\"data/img/afd0077237ca16d34eea.svg\" alt=\"Pine Quiver\"></div><h3>Pine Quiver</h3><table>\n      \n      \n      \n      <tr><th>Made with</th><td>Bowyer 3</td></tr>\n      \n      \n      \n      \n    </table></aside></article>"}